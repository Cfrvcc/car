<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows Server / IIS serverlərdə əsas saytın yönləndirməsini sıfırlamaq üçün -->
<configuration>
    <system.webServer>
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <clear />
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
